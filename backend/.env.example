# 配置示例：复制为 backend/.env 后填写；实际密钥与密码不得提交版本库。
# 环境变量优先于当前工作目录的 .env，再采用Settings默认值；修改后需重启服务。
# 数值是示例配置，不一定等于 Settings 的默认值；更换模型须同步调整上下文参数。
# 思考开关由 Provider 与 Protocol 显式映射：DeepSeek 发送 thinking.type=enabled/disabled；OpenAI 主 Agent 使用 Responses API 与 reasoning 参数控制，百炼 Responses 使用 reasoning.effort（关闭为 none）；Title/Summary/Recommendation/Vision 使用 Chat Completions，DashScope Qwen 通过 extra_body.enable_thinking 控制思考。

# ===== 主模型与辅助任务 =====
# 主模型 Provider（deepseek/openai）；决定官方 integration 与 thinking 参数映射，不靠模型名猜测。
LLM_PROVIDER=openai
# 主模型接口地址；标题、推荐、摘要复用该端点，视觉模型独立配置。openai 可连接官方 API 或严格遵循 OpenAI 标准协议的兼容端点。
LLM_BASE_URL=https://api.openai.com/v1
# 主模型接口密钥；标题、推荐、摘要复用。实际调用前填写，不提交版本库。
LLM_API_KEY=sk-xxxx
# 端点支持的主模型标识；标题、推荐、摘要复用。Settings 默认 deepseek-flash，此处是与 openai 示例端点匹配的示例值。
LLM_MODEL=gpt-4o-mini
# 主模型思考开关，true/false；Settings 默认 true。Provider 层显式映射供应商官方参数（DeepSeek：thinking.type=enabled/disabled；OpenAI 使用 Responses API 与 reasoning 参数控制，DashScope Responses 使用 reasoning.effort，关闭为 none），此例 false；不影响辅助任务开关。
LLM_THINKING=false

# 标题模型独立思考开关，true/false，默认 false；开关语义同 LLM_THINKING，不继承 LLM_THINKING。
TITLE_THINKING=false
# 是否生成下一步问题建议，true/false，默认 true；false 跳过模型调用并清空旧建议。
RECOMMEND_ENABLED=true
# 推荐模型独立思考开关，true/false，默认 false；开关语义同 LLM_THINKING，不继承 LLM_THINKING。
RECOMMEND_THINKING=false

# ===== 官方单轮调用与重试预算 =====
# 主模型/单工具额外重试次数，0–5，默认 2；含首次最多3次，仅重试明确瞬时失败。
AGENT_MAX_RETRIES=2
# 指数退避初始基础延时，单位秒，0–10，默认 0.5；倍率固定2，0表示不等待。
AGENT_RETRY_INITIAL_DELAY=0.5
# 基础延时上限，单位秒，0–30，默认4；封顶后仍有±25%抖动，不是实际等待硬上限。
AGENT_RETRY_MAX_DELAY=4
# 每Run主模型逻辑调用上限，1–100，默认20；重试另算，超限停止本轮，下一轮重置。
AGENT_MODEL_RUN_LIMIT=20
# 每Run工具逻辑调用上限，1–200，默认40；重试另算，超额调用error，允许的调用仍执行。
# 上述调用限额不是全部HTTP请求数量或耗时预算；摘要仍走独立官方逻辑。
AGENT_TOOL_RUN_LIMIT=80

# ===== 北斗监测平台 =====
# 平台API根地址；Settings默认空值，使用平台工具前填写，客户端追加各接口路径。
BEIDOU_API_BASE_URL=http://39.96.80.62/bdjc-api/v2/API
# 平台登录用户名，默认空值；与密码一起填写，账号权限决定数据访问范围。
BEIDOU_USERNAME=
# 平台登录密码，默认空值；仅运行时配置，不提交版本库或转发模型/前端。
BEIDOU_PASSWORD=

# ===== 视觉复核 =====
# 独立OpenAI兼容视觉端点，默认空值；端点/密钥/模型缺任一项会返回error，保留图表。
# 视觉模型 Provider（deepseek/openai）；与主模型独立，决定官方 integration 与 thinking 参数映射。
VISION_PROVIDER=openai
VISION_BASE_URL=
# 视觉接口密钥，默认空值；不复用LLM_API_KEY，不提交版本库。
VISION_API_KEY=
# 支持图像输入、在视觉端点可用的模型标识，默认空值；不复用LLM_MODEL。
VISION_MODEL=
# 视觉模型独立思考开关，true/false，默认false；开关语义同LLM_THINKING，不继承LLM_THINKING。视觉调用采用 Chat Completions 协议与官方 structured output；针对 DashScope Qwen 模型自动映射 extra_body.enable_thinking。
VISION_THINKING=false

# 候选数值核验向起止两侧各外扩的小时数，默认2；限制在原窗口内，0不外扩，负值按0处理。
VISION_RECHECK_PAD_HOURS=2
# 单次视觉工具尝试的有效候选上限，1–50，默认12；超额拒绝数值回查，提示缩小窗口，不静默裁剪。
VISION_MAX_CANDIDATES=12

# ===== 官方token驱动的历史摘要与用量展示 =====
# 消息token触发阈值，正整数，默认800000；采用官方计数，与展示估算/窗口比例无关。
CONTEXT_TOKEN_THRESHOLD=800000
# 必填正整数，无默认；当前LLM模型实际上下文窗口，单位token。换模型必须同步修改。
# 1048576仅为窗口示例，需与实际模型匹配；此值用于用量展示，不决定压缩触发线。
CONTEXT_MODEL_CONTEXT=1048576
# 摘要后近期消息token budget，正整数，默认400000；工具配对与安全切点沿用官方规则。
CONTEXT_KEEP_TOKENS=400000
# 摘要输出max_tokens，正整数，默认2000；与近期消息保留budget不同。
CONTEXT_SUMMARY_MAX_TOKENS=2000
# 展示用输出预留token数，建议非负，默认8192；负值按0处理，不设置主模型输出上限/压缩规则。
CONTEXT_OUTPUT_RESERVE_TOKENS=8192
# 展示用协议/计数误差预留token数，建议非负，默认2048；负值按0处理，不参与压缩决策。
CONTEXT_SAFETY_MARGIN_TOKENS=2048
# 展示近似计数的保守倍率，建议≥1，默认1.1；运行时至少按1计算，不影响实际usage/官方压缩计数。
CONTEXT_TOKEN_ESTIMATE_FACTOR=1.1
# 展示近似计数的字符/token换算值，必须>0，默认1.6667；按模型调整，非正值估算时报错。
CONTEXT_CHARS_PER_TOKEN=1.6667
# 摘要模型独立思考开关，true/false，默认false；开关语义同LLM_THINKING，复用主模型配置但不继承LLM_THINKING。
COMPRESS_THINKING=false

# ===== Agent Server / Docker持久化部署（由服务/Compose读取，不属于Settings字段） =====
# LangSmith服务密钥，用于Agent Server部署所需的服务认证；实际部署时填写，不提交版本库。
# 可在 https://smith.langchain.com 的 Settings / API Keys 获取。
LANGSMITH_API_KEY=
# PostgreSQL密码，docker-compose.yml用其配置数据库并构造DATABASE_URI；部署前替换示例密码。
# DATABASE_URI与REDIS_URI由Compose注入，无需在此重复配置；此项不影响langgraph dev的本地存储。
POSTGRES_PASSWORD=change-me
