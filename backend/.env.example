# 配置示例：外部服务地址和凭据均为占位符；复制为 backend/.env 后在本地填写真实配置。
# 环境变量优先于当前工作目录的 .env，再采用Settings默认值；修改后需重启服务。
# 数值是示例配置，不一定等于 Settings 的默认值；更换模型须同步调整上下文参数。
# 思考开关由 Provider 与 Protocol 显式映射：DeepSeek 发送 thinking.type=enabled/disabled；OpenAI 主 Agent 使用 Responses API 与 reasoning 参数控制，百炼 Responses 使用 reasoning.effort（关闭为 none）；Title/Summary 使用 Chat Completions。

# ===== 主模型与辅助任务 =====
# 主模型 Provider（deepseek/openai）；决定官方 integration 与 thinking 参数映射，不靠模型名猜测。
LLM_PROVIDER=openai
# 主模型接口地址；标题、摘要复用该端点。openai 可连接官方 API 或严格遵循 OpenAI 标准协议的兼容端点。
LLM_BASE_URL=https://llm.example.invalid/v1
# 主模型接口密钥；标题、摘要复用。实际调用前填写，不提交版本库。
LLM_API_KEY=replace_with_llm_api_key
# 端点支持的主模型标识；标题、摘要复用。Settings 默认 deepseek-flash，此处是与 openai 示例端点匹配的示例值。
LLM_MODEL=gpt-4o-mini
# 主模型思考开关，true/false；Settings 默认 true。Provider 层显式映射供应商官方参数（DeepSeek：thinking.type=enabled/disabled；OpenAI 使用 Responses API 与 reasoning 参数控制，DashScope Responses 使用 reasoning.effort，关闭为 none），此例 false；不影响辅助任务开关。
LLM_THINKING=false

# 标题模型独立思考开关，true/false，默认 false；开关语义同 LLM_THINKING，不继承 LLM_THINKING。
TITLE_THINKING=false

# ===== 官方单轮调用与重试预算 =====
# 主模型/单工具额外重试次数，0–5，默认 2；含首次最多3次，仅重试明确瞬时失败。
AGENT_MAX_RETRIES=2
# 指数退避初始基础延时，单位秒，0–10，默认 0.5；倍率固定2，0表示不等待。
AGENT_RETRY_INITIAL_DELAY=0.5
# 基础延时上限，单位秒，0–30，默认4；封顶后仍有±25%抖动，不是实际等待硬上限。
AGENT_RETRY_MAX_DELAY=4
# 每Run主模型逻辑调用上限，1–100，默认15；重试另算，最后一次调用撤掉工具直接作答，下一轮重置。决定最坏等待时间，按真实调查分布校准。
AGENT_MODEL_RUN_LIMIT=15
# 每Run取数类工具调用上限，1–200，默认20；compute、结论登记、以往结论、最近巡检和重复的相同取数不计入，重试另算，超额调用error。
# 上述调用限额不是全部HTTP请求数量或耗时预算；摘要仍走独立官方逻辑。
AGENT_TOOL_RUN_LIMIT=20
# 位移结果自动附带逐点数据的点数上限，0–1000，默认72（约3天小时数据）；超过时只给特征，模型可显式要求或用compute。
# 逐点数据随每次模型调用重复发送，过大时多测点调查的输入token成倍增长。
AGENT_INLINE_POINTS_LIMIT=72
# compute单次计算运行时间上限，单位秒，1–60，默认10；超时终止子进程。
COMPUTE_TIMEOUT_SECONDS=10

# ===== 北斗监测平台 =====
# 平台API根地址；Settings默认空值，使用平台工具前填写，客户端追加各接口路径。
BEIDOU_API_BASE_URL=https://beidou.example.invalid/bdjc-api/v2/API
# 平台登录用户名，默认空值；与密码一起填写，账号权限决定数据访问范围。
BEIDOU_USERNAME=
# 平台登录密码，默认空值；仅运行时配置，不提交版本库或转发模型/前端。
BEIDOU_PASSWORD=

# ===== 地图 =====
# 高德 JavaScript API 密钥，会下发到已登录浏览器；需配置部署域名白名单。
# 为空时提示地图未配置，仍可查看场地资料和原始 WGS84 坐标。
AMAP_TOKEN=

# ===== 访问保护 =====
# 登录账号，默认 admin；单账号，不是用户体系。
AUTH_USERNAME=admin
# 登录密码；为空时不启用访问保护，仅限本地开发与测试，生产必须填写。
AUTH_PASSWORD=
# 登录 Cookie 签名密钥，填写密码时必填，至少 32 个字符，例如 openssl rand -hex 32 的输出；更换后需要重新登录。
AUTH_SECRET=

# ===== 官方token驱动的历史摘要与用量展示 =====
# 消息token触发阈值，正整数，默认160000；采用官方计数，与展示估算/窗口比例无关。过高时摘要永不触发，每次调用都携带全部历史。
CONTEXT_TOKEN_THRESHOLD=160000
# 必填正整数，无默认；自定义端点主模型的最大输入token数，写入LangChain Model Profile。换模型必须同步修改。
# 1048576仅为示例，需与实际模型匹配；只供实际provider usage展示占比，不决定压缩触发线。
CONTEXT_MODEL_CONTEXT=1048576
# 摘要后近期消息token budget，正整数，默认48000，应小于触发阈值；工具配对与安全切点沿用官方规则。
CONTEXT_KEEP_TOKENS=48000
# 摘要输出max_tokens，正整数，默认2000；与近期消息保留budget不同。
CONTEXT_SUMMARY_MAX_TOKENS=2000
# 摘要模型独立思考开关，true/false，默认false；开关语义同LLM_THINKING，复用主模型配置但不继承LLM_THINKING。
COMPRESS_THINKING=false

# ===== 自托管 API / PostgreSQL =====
# 自托管 API 与迁移命令必填，无默认；Compose 自动注入，单独启动 Python 时填写独立数据库。
# 本机旧 lma_pgdata 保留不动；新数据库不导入旧会话。密码包含特殊字符时须 URL 编码。
DATABASE_URI=postgresql://lma:INVALID_EXAMPLE_PASSWORD@127.0.0.1:55433/lma
# 数据库连接池上限，2–20，默认6，单位连接；单个 worker 生效。
DATABASE_POOL_SIZE=6
# 跨源前端Origin，逗号分隔，默认空值仅同源；生产使用/api无需设置。
CORS_ORIGINS=
# Compose数据库密码，必填，无默认；建议64位随机十六进制字符，部署时保存在服务器600权限.env。
# 此变量由Compose读取，不属于Settings；不会修改旧数据库。
POSTGRES_PASSWORD=INVALID_EXAMPLE_PASSWORD
# 可选追踪开关，默认false；本部署不依赖LangSmith或Agent Server许可证。
LANGSMITH_TRACING=false
