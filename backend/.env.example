# ===== LLM (OpenAI-compatible API: DeepSeek/Qwen/GPT etc.) =====
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=gpt-4o-mini
# 主模型思考过程：仅对支持 enable_thinking 与 reasoning_content 的兼容接口设为 true
LLM_THINKING=false
# 辅助任务各自独立控制，默认均关闭，不继承 LLM_THINKING
TITLE_THINKING=false
RECOMMEND_ENABLED=true
RECOMMEND_THINKING=false

# ===== Beidou platform (test account, will be replaced by user-bound credentials) =====
# Base URL per project docs, default v2
BEIDOU_API_BASE_URL=http://39.96.80.62/bdjc-api/v2/API
BEIDOU_USERNAME=
BEIDOU_PASSWORD=

# vision model
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# ===== LangGraph Server Docker deployment (license check) =====
# langgraph-api >= 0.14 requires LANGSMITH_API_KEY at container startup
# (free LangSmith account works for dev-scale self-hosting).
# Get one at https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_API_KEY=

# ===== PostgreSQL persistence (docker compose deployment) =====
# DATABASE_URI is injected by docker-compose.yml at runtime;
# this password is referenced by compose for both the postgres container and DATABASE_URI.
POSTGRES_PASSWORD=change-me

# 视觉模型独立思考开关，默认关闭
VISION_THINKING=false

# ===== Context management (token-triggered history compression) =====
# 触发线 = min(CONTEXT_TOKEN_THRESHOLD, CONTEXT_MODEL_CONTEXT * CONTEXT_COMPRESS_RATIO)
# 必填；DeepSeek V4 Flash 官方窗口为 1048576，更换模型时必须同步修改。
# 压缩后目标水位为触发线的 50%（CONTEXT_TARGET_RATIO），最少保留 2 段对话。
CONTEXT_TOKEN_THRESHOLD=800000
CONTEXT_MODEL_CONTEXT=1048576
CONTEXT_COMPRESS_RATIO=0.8
CONTEXT_TARGET_RATIO=0.5
CONTEXT_MIN_TURNS=2
CONTEXT_SUMMARY_MAX_TOKENS=2000
# 为本轮输出和协议/tokenizer 误差预留；兼容模型估算系数不得低于 1。
CONTEXT_OUTPUT_RESERVE_TOKENS=8192
CONTEXT_SAFETY_MARGIN_TOKENS=2048
CONTEXT_TOKEN_ESTIMATE_FACTOR=1.1
# DeepSeek 官方参考换算：1 中文字符约 0.6 token，即约 1.6667 字符/token。
CONTEXT_CHARS_PER_TOKEN=1.6667

# 压缩模型（OpenAI 兼容，不配置则复用主 LLM 配置）
COMPRESS_BASE_URL=
COMPRESS_API_KEY=
COMPRESS_MODEL=
COMPRESS_THINKING=false

# 视觉定位异常区间的数值核验外扩小时数（0 表示不外扩）
VISION_RECHECK_PAD_HOURS=2
